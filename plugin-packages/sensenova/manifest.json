{
  "apiVersion": "yingce.plugin/v1",
  "id": "sensenova-provider",
  "name": "SenseNova 渠道",
  "version": "1.0.0",
  "enabled": true,
  "author": "影策社区",
  "description": "接入商汤日日新 (SenseNova) 生态大模型，支持 SenseNova 6.8 Flash Lite 文本/多模态对话以及 SenseNova U1.5 Lite、SenseNova U1 Fast 图像生成与编辑。",
  "documentation": "# SenseNova 渠道插件\n\n## 接口协议\n\n- 对话与多模态：`POST /chat/completions`\n- 文生图：`POST /images/generations`\n- 图像编辑：`POST /images/edits`\n\n## 官方支持模型\n\n- `sensenova-6.8-flash-lite`（多模态文本对话、图像理解）\n- `sensenova-u1.5-lite`（2K/4K 文生图与单图编辑）\n- `sensenova-u1-fast`（2K 信息图专用生成）\n",
  "permissions": [
    "generation.run",
    "media.read"
  ],
  "configuration": {
    "fields": [
      {
        "name": "apiKey",
        "type": "secret",
        "label": "SenseNova API Key",
        "required": true,
        "description": "填写商汤日日新 (SenseNova) 控制台生成的 API Key。"
      }
    ]
  },
  "contributes": {
    "providers": [
      {
        "id": "sensenova-chat",
        "label": "SenseNova 文本",
        "capabilities": [
          "text"
        ],
        "scopes": [
          "admin.system-channel",
          "user.custom-channel",
          "canvas",
          "creation"
        ],
        "auth": {
          "type": "bearer",
          "field": "apiKey",
          "header": "Authorization"
        },
        "parameters": [
          { "name": "model", "type": "string", "required": true, "mapping": "model" },
          { "name": "prompt", "type": "string", "required": true, "mapping": "prompt" }
        ],
        "create": {
          "method": "POST",
          "path": "/chat/completions",
          "contentType": "application/json",
          "fields": {
            "model": "request.model",
            "messages": "request.messages",
            "stream": "false|bool"
          }
        },
        "response": {
          "resultPaths": [
            "choices.0.message.content"
          ],
          "resultKind": "text"
        }
      },
      {
        "id": "sensenova-image",
        "label": "SenseNova 图片",
        "capabilities": [
          "image"
        ],
        "scopes": [
          "admin.system-channel",
          "user.custom-channel",
          "canvas",
          "creation"
        ],
        "auth": {
          "type": "bearer",
          "field": "apiKey",
          "header": "Authorization"
        },
        "parameters": [
          { "name": "model", "type": "string", "required": true, "mapping": "model" },
          { "name": "prompt", "type": "string", "required": true, "mapping": "prompt" },
          { "name": "images", "type": "array", "mapping": "images" },
          { "name": "size", "type": "string", "mapping": "aspectRatio" },
          { "name": "watermark", "type": "boolean", "mapping": "watermark" }
        ],
        "create": {
          "method": "POST",
          "path": "/images/generations",
          "contentType": "application/json",
          "fields": {
            "model": "request.model",
            "prompt": "request.prompt",
            "size": "request.aspectRatio",
            "n": "1|int",
            "watermark": "request.watermark"
          }
        },
        "response": {
          "resultPaths": [
            "data"
          ],
          "resultKind": "image"
        }
      }
    ],
    "workflows": [
      {
        "id": "sensenova-6.8-flash-lite",
        "label": "SenseNova 6.8 Flash Lite",
        "providerId": "sensenova-chat",
        "capability": "text"
      },
      {
        "id": "sensenova-u1.5-lite",
        "label": "SenseNova U1.5 Lite",
        "providerId": "sensenova-image",
        "capability": "image"
      },
      {
        "id": "sensenova-u1-fast",
        "label": "SenseNova U1 Fast",
        "providerId": "sensenova-image",
        "capability": "image"
      }
    ]
  }
}
